<!doctype html>
<html lang="pt-BR">
  <%- include('../../partials/head', { title: 'Meus Conhecimentos' }) %>
  <body>
    <%- include('../../partials/navbar') %>
    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Meus Conhecimentos</h3>
        <a class="btn btn-sm btn-outline-secondary" href="/projects">Voltar</a>
      </div>

      <form method="post" action="/my/knowledges">
        <table class="table table-sm">
          <thead><tr><th>Conhecimento</th><th>Nível (0–10)</th><th></th></tr></thead>
          <tbody>
            <% knowledges.forEach(k => { 
                 const cur = mapLevels[k.id] ? mapLevels[k.id].level : '';
                 const skId = mapLevels[k.id] ? mapLevels[k.id].id : null;
            %>
              <tr>
                <td><%= k.name %></td>
                <td style="width:200px;">
                  <select name="level_<%= k.id %>" class="form-select">
                    <option value="">—</option>
                    <% for(let i=0;i<=10;i++){ %>
                      <option value="<%= i %>" <%= (String(i) === String(cur)) ? 'selected' : '' %>><%= i %></option>
                    <% } %>
                  </select>
                </td>
                <td>
                  <% if (skId) { %>
                    <form method="post" action="/my/knowledges/<%= skId %>/delete" style="display:inline" onsubmit="return confirm('Remover este conhecimento?')">
                      <button class="btn btn-sm btn-outline-danger">Remover</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <div class="d-flex gap-2">
          <button class="btn btn-primary">Salvar</button>
          <a class="btn btn-secondary" href="/projects">Cancelar</a>
        </div>
      </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>