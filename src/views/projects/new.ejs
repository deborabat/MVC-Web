<!doctype html>
<html lang="pt-BR">
  <%- include('../partials/head', { title: 'Novo Projeto' }) %>
  <body>
    <%- include('../partials/navbar') %>

    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
          <div class="card shadow-sm">
            <div class="card-body">
              <h3 class="card-title mb-3">Novo Projeto</h3>

              <form method="post" action="/projects">
                <div class="mb-3">
                  <label class="form-label">Nome</label>
                  <input name="name" class="form-control" required>
                </div>

                <div class="mb-3">
                  <label class="form-label">Resumo</label>
                  <textarea name="summary" class="form-control" rows="4" required></textarea>
                </div>

                <div class="mb-3">
                  <label class="form-label">Link externo (opcional)</label>
                  <input name="externalLink" class="form-control">
                </div>

                <div class="mb-3">
                  <label class="form-label">Palavras-chave (selecione várias)</label>
                  <select name="keywordIds" class="form-select" multiple size="6">
                    <% keywords.forEach(k => { %>
                      <option value="<%= k.id %>"><%= k.name %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label">Desenvolvedores (incluir outros alunos)</label>
                  <select name="studentIds" class="form-select" multiple size="6">
                    <% students.forEach(s => { %>
                      <option value="<%= s.id %>"><%= s.name %></option>
                    <% }) %>
                  </select>
                  <div class="form-text">Você será incluído automaticamente como desenvolvedor.</div>
                </div>

                <div class="d-grid">
                  <button class="btn btn-primary">Criar Projeto</button>
                </div>
              </form>

            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>