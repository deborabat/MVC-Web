<!doctype html>
<html lang="pt-BR">
  <%- include('../partials/head', { title: 'Editar Projeto' }) %>
  <body>
    <%- include('../partials/navbar') %>

    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">
          <div class="card shadow-sm">
            <div class="card-body">
              <h3 class="card-title mb-3">Editar Projeto</h3>

              <form method="post" action="/projects/<%= project.id %>">
                <div class="mb-3">
                  <label class="form-label">Nome</label>
                  <input name="name" class="form-control" value="<%= project.name %>" required>
                </div>

                <div class="mb-3">
                  <label class="form-label">Resumo</label>
                  <textarea name="summary" class="form-control" rows="4" required><%= project.summary %></textarea>
                </div>

                <div class="mb-3">
                  <label class="form-label">Link externo (opcional)</label>
                  <input name="externalLink" class="form-control" value="<%= project.externalLink %>">
                </div>

                <div class="mb-3">
                  <label class="form-label">Palavras-chave</label>
                  <select name="keywordIds" class="form-select" multiple size="6">
                    <% keywords.forEach(k => { %>
                      <option value="<%= k.id %>" <%= project.keywords.some(pk => pk.id === k.id) ? 'selected' : '' %>><%= k.name %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label">Desenvolvedores</label>
                  <select name="studentIds" class="form-select" multiple size="6">
                    <% students.forEach(s => { %>
                      <option value="<%= s.id %>" <%= project.students.some(ps => ps.id === s.id) ? 'selected' : '' %>><%= s.name %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="d-flex gap-2">
                  <button class="btn btn-primary">Salvar</button>
                  <a class="btn btn-secondary" href="/projects">Cancelar</a>
                </div>
              </form>

            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>