<!doctype html>
<html lang="pt-BR">
  <%- include('../partials/head', { title: 'Projetos' }) %>
  <body>
    <%- include('../partials/navbar') %>

    <div class="container">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3">Projetos</h1>
        <a class="btn btn-success" href="/projects/new">Novo Projeto</a>
      </div>

      <% if (!projects || projects.length === 0) { %>
        <div class="alert alert-info">Nenhum projeto encontrado.</div>
      <% } else { %>
        <div class="row g-3">
          <% projects.forEach(p => { %>
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title"><%= p.name %></h5>
                  <p class="card-text text-truncate"><%= p.summary %></p>
                  <% if (p.externalLink) { %>
                    <a href="<%= p.externalLink %>" target="_blank" class="mb-2">Link externo</a>
                  <% } %>

                  <div class="mt-auto">
                    <p class="mb-1"><strong>Palavras-chave:</strong> <%= p.keywords.map(k => k.name).join(', ') || '-' %></p>
                    <p class="mb-2"><strong>Desenvolvedores:</strong> <%= p.students.map(s => s.name).join(', ') || '-' %></p>

                    <div class="d-flex gap-2">
                      <a class="btn btn-sm btn-outline-primary" href="/projects/<%= p.id %>/edit">Editar</a>
                      <form method="post" action="/projects/<%= p.id %>/delete" onsubmit="return confirm('Excluir projeto?')">
                        <button class="btn btn-sm btn-danger">Excluir</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>