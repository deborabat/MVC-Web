<!doctype html>
<html lang="pt-BR">
  <%- include('../../partials/head', { title: 'Alunos' }) %>
  <body>
    <%- include('../../partials/navbar') %>
    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Alunos</h3>
        <a class="btn btn-sm btn-success" href="/admin/students/new">Novo Aluno</a>
      </div>
      <table class="table table-sm">
        <thead><tr><th>ID</th><th>Nome</th><th>Email</th><th>Admin</th><th></th></tr></thead>
        <tbody>
          <% students.forEach(s => { %>
            <tr>
              <td><%= s.id %></td>
              <td><%= s.name %></td>
              <td><%= s.email %></td>
              <td><%= s.isAdmin ? 'Sim' : 'Não' %></td>
              <td>
                <a class="btn btn-sm btn-primary" href="/admin/students/<%= s.id %>/edit">Editar</a>
                <form method="post" action="/admin/students/<%= s.id %>/delete" style="display:inline" onsubmit="return confirm('Excluir?')">
                  <button class="btn btn-sm btn-danger">Excluir</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>