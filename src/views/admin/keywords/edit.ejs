<!doctype html>
<html lang="pt-BR">
  <%- include('../../partials/head', { title: 'Editar Palavra‑chave' }) %>
  <body>
    <%- include('../../partials/navbar') %>
    <div class="container py-4">
      <h3>Editar Palavra‑chave</h3>
      <form method="post" action="/admin/keywords/<%= keyword.id %>">
        <div class="mb-3">
          <label class="form-label">Nome</label>
          <input name="name" class="form-control" value="<%= keyword.name %>" required>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-primary">Salvar</button>
          <a class="btn btn-secondary" href="/admin/keywords">Cancelar</a>
        </div>
      </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>