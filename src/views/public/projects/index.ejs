<!doctype html>
<html lang="pt-BR">
  <%- include('../../partials/head', { title: filterKeyword ? `Projetos - ${filterKeyword}` : 'Projetos' }) %>
  <body>
    <%- include('../../partials/navbar') %>

    <div class="container py-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4"><%= filterKeyword ? `Projetos - ${filterKeyword}` : 'Projetos' %></h1>

        <form class="d-flex" method="get" action="/projects">
          <select name="keywordId" class="form-select form-select-sm me-2">
            <option value="">Todas as palavras‑chave</option>
            <% if (keywords) { %>
              <% keywords.forEach(k => { %>
                <option value="<%= k.id %>" <%= (String(selectedKeyword) === String(k.id)) ? 'selected' : '' %>><%= k.name %></option>
              <% }) %>
            <% } %>
          </select>
          <button class="btn btn-sm btn-outline-secondary" type="submit">Filtrar</button>
        </form>
      </div>

      <% if (!projects || projects.length === 0) { %>
        <div class="alert alert-info">Nenhum projeto encontrado.</div>
      <% } else { %>
        <div class="row g-3">
          <% projects.forEach(p => { %>
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title"><%= p.name %></h5>
                  <p class="card-text"><%= p.summary %></p>
                  <% if (p.externalLink) { %>
                    <a href="<%= p.externalLink %>" target="_blank" class="mb-2">Link externo</a>
                  <% } %>

                  <div class="mt-auto">
                    <p class="mb-1"><strong>Palavras-chave:</strong> <%= p.keywords.map(k => k.name).join(', ') || '-' %></p>
                    <p class="mb-0"><strong>Desenvolvedores:</strong> <%= p.students.map(s => s.name).join(', ') || '-' %></p>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>